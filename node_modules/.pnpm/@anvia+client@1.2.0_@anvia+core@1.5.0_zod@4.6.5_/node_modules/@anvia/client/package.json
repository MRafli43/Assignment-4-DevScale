{
  "name": "@anvia/client",
  "version": "1.2.0",
  "description": "Framework-neutral client protocol, transports, and UI message state for Anvia.",
  "author": "anvia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anvia-hq/anvia",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "import": "./dist/transport/index.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "@anvia/core": "1.2.1"
  },
  "peerDependencies": {
    "@anvia/core": "^1.2.1"
  },
  "scripts": {
    "build": "tsup src/index.ts src/transport/index.ts --format esm --dts --sourcemap --clean",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}